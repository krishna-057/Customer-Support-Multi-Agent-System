# Copy to .env and choose a unique local password. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=54329
CRM_ACCOUNT_READ_TOKEN=replace-with-a-unique-account-read-token
CRM_BILLING_READ_TOKEN=replace-with-a-different-billing-read-token
CRM_BILLING_REQUEST_TOKEN=replace-with-a-third-billing-request-token
CRM_BILLING_EXECUTE_TOKEN=replace-with-a-distinct-billing-execute-token
CRM_ESCALATION_WRITE_TOKEN=replace-with-a-distinct-escalation-write-token
LOGISTICS_ORDER_READ_TOKEN=replace-with-a-fourth-logistics-read-token
TECHNICAL_RETRIEVAL_TOKEN=replace-with-a-fifth-technical-retrieval-token
CUSTOMER_SESSION_SECRET=replace-with-a-unique-32-plus-byte-session-secret
ADMIN_SESSION_SECRET=replace-with-a-different-32-plus-byte-admin-session-secret
